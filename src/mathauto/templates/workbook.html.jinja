<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
<style>
  body { font-family: "Noto Sans KR", "Malgun Gothic", sans-serif; margin: 40px; color: #111; }
  h1 { text-align: center; }
  h2 { margin-top: 0; }
  .problem { page-break-inside: avoid; margin-bottom: 22px; }
  .problem .number, .answer-item .number { font-weight: bold; margin-right: 6px; }
  .choices { margin: 8px 0 0 20px; }
  .answer-key { page-break-before: always; }
  .answer-item { page-break-inside: avoid; margin-bottom: 18px; }
  .steps { margin: 4px 0 0 20px; }
  .note { color: #b45309; font-size: 0.85em; margin-top: 4px; }
</style>
</head>
<body>
<h1>{{ title }}</h1>

<section class="problems">
{% for e in entries %}
  <div class="problem">
    <span class="number">{{ e.number }}.</span>
    <span class="text">{{ e.problem_text }}</span>
    {% if e.choices %}
    <ol class="choices">
      {% for c in e.choices %}<li>{{ c }}</li>{% endfor %}
    </ol>
    {% endif %}
  </div>
{% endfor %}
</section>

<section class="answer-key">
  <h2>정답 및 풀이</h2>
  {% for e in entries %}
  <div class="answer-item">
    <span class="number">{{ e.number }}.</span>
    <strong>{{ e.final_answer }}</strong>
    {% if e.solution_steps %}
    <ol class="steps">
      {% for s in e.solution_steps %}<li>{{ s }}</li>{% endfor %}
    </ol>
    {% endif %}
    {% if e.notes %}
    <div class="note">⚠ 확인 필요: {{ e.notes | join(' / ') }}</div>
    {% endif %}
  </div>
  {% endfor %}
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    renderMathInElement(document.body, {
      delimiters: [
        { left: "$$", right: "$$", display: true },
        { left: "$", right: "$", display: false }
      ]
    });
  });
</script>
</body>
</html>
